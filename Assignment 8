        "# Assignment 8\n",
        "# Calculate State Value and Action Value for Grid World\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. Define States\n",
        "# --------------------------------------------------\n",
        "\n",
        "states = {\n",
        "    \"S0\": (0, 0),\n",
        "    \"S1\": (0, 1),\n",
        "    \"G\":  (0, 2),\n",
        "    \"S3\": (1, 1),\n",
        "    \"S4\": (1, 2)\n",
        "}\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. Define Grid\n",
        "# --------------------------------------------------\n",
        "\n",
        "grid = [\n",
        "    [\"S0\", \"S1\", \"G\"],\n",
        "    [\"X\",  \"S3\", \"S4\"]\n",
        "]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. Define Actions\n",
        "# --------------------------------------------------\n",
        "\n",
        "actions = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. Define Rewards\n",
        "# --------------------------------------------------\n",
        "\n",
        "NORMAL_REWARD = -1\n",
        "GOAL_REWARD = 10\n",
        "OBSTACLE_REWARD = -5\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. Discount Factor\n",
        "# --------------------------------------------------\n",
        "\n",
        "gamma = 0.9\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. Define Policy\n",
        "# --------------------------------------------------\n",
        "\n",
        "policy = {\n",
        "    \"S0\": \"Right\",\n",
        "    \"S1\": \"Down\",\n",
        "    \"S3\": \"Right\",\n",
        "    \"S4\": \"Up\"\n",
        "}\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. Transition Function\n",
        "# --------------------------------------------------\n",
        "\n",
        "def transition(state, action):\n",
        "\n",
        "    # Goal state is terminal\n",
        "    if state == \"G\":\n",
        "        return \"G\"\n",
        "\n",
        "    row, col = states[state]\n",
        "\n",
        "    # Find new position\n",
        "    if action == \"Up\":\n",
        "        new_row = row - 1\n",
        "        new_col = col\n",
        "\n",
        "    elif action == \"Down\":\n",
        "        new_row = row + 1\n",
        "        new_col = col\n",
        "\n",
        "    elif action == \"Left\":\n",
        "        new_row = row\n",
        "        new_col = col - 1\n",
        "\n",
        "    elif action == \"Right\":\n",
        "        new_row = row\n",
        "        new_col = col + 1\n",
        "\n",
        "    else:\n",
        "        return state\n",
        "\n",
        "    # Check grid boundary\n",
        "    if new_row < 0 or new_row >= 2:\n",
        "        return state\n",
        "\n",
        "    if new_col < 0 or new_col >= 3:\n",
        "        return state\n",
        "\n",
        "    next_state = grid[new_row][new_col]\n",
        "\n",
        "    # Obstacle cannot be entered\n",
        "    if next_state == \"X\":\n",
        "        return state\n",
        "\n",
        "    return next_state\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. Reward Function\n",
        "# --------------------------------------------------\n",
        "\n",
        "def get_reward(state, action):\n",
        "\n",
        "    next_state = transition(state, action)\n",
        "\n",
        "    if next_state == \"G\":\n",
        "        return GOAL_REWARD\n",
        "\n",
        "    return NORMAL_REWARD\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 9. State Value Function\n",
        "# --------------------------------------------------\n",
        "\n",
        "def state_value_function():\n",
        "\n",
        "    # Goal state value\n",
        "    V_G = 0\n",
        "\n",
        "    # S4 -> Up -> G\n",
        "    V_S4 = get_reward(\"S4\", \"Up\") + gamma * V_G\n",
        "\n",
        "    # S3 -> Right -> S4\n",
        "    V_S3 = get_reward(\"S3\", \"Right\") + gamma * V_S4\n",
        "\n",
        "    # S1 -> Down -> S3\n",
        "    V_S1 = get_reward(\"S1\", \"Down\") + gamma * V_S3\n",
        "\n",
        "    # S0 -> Right -> S1\n",
        "    V_S0 = get_reward(\"S0\", \"Right\") + gamma * V_S1\n",
        "\n",
        "    return {\n",
        "        \"G\": V_G,\n",
        "        \"S4\": V_S4,\n",
        "        \"S3\": V_S3,\n",
        "        \"S1\": V_S1,\n",
        "        \"S0\": V_S0\n",
        "    }\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 10. Action Value Function\n",
        "# --------------------------------------------------\n",
        "\n",
        "def action_value_function(state, action, values):\n",
        "\n",
        "    next_state = transition(state, action)\n",
        "\n",
        "    reward = get_reward(state, action)\n",
        "\n",
        "    # If goal is reached, episode terminates\n",
        "    if next_state == \"G\":\n",
        "        return reward\n",
        "\n",
        "    # Otherwise:\n",
        "    # Q(s,a) = R + gamma * V(next_state)\n",
        "    return reward + gamma * values[next_state]\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 11. Main Program\n",
        "# --------------------------------------------------\n",
        "\n",
        "values = state_value_function()\n",
        "\n",
        "print(\"========================================\")\n",
        "print(\"       GRID WORLD VALUE CALCULATION\")\n",
        "print(\"========================================\")\n",
        "\n",
        "print(\"\\nDiscount Factor =\", gamma)\n",
        "\n",
        "print(\"\\nPolicy:\")\n",
        "for state, action in policy.items():\n",
        "    print(state, \"->\", action)\n",
        "\n",
        "print(\"\\nState Values:\")\n",
        "print(\"V(G)  =\", values[\"G\"])\n",
        "print(\"V(S4) =\", values[\"S4\"])\n",
        "print(\"V(S3) =\", values[\"S3\"])\n",
        "print(\"V(S1) =\", values[\"S1\"])\n",
        "print(\"V(S0) =\", values[\"S0\"])\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 12. Calculate Q(S0, Up)\n",
        "# --------------------------------------------------\n",
        "\n",
        "q_value = action_value_function(\"S0\", \"Up\", values)\n",
        "\n",
        "print(\"\\nAction Value:\")\n",
        "print(\"Q(S0, Up) =\", q_value)\n",
        "\n",
        "print(\"\\n========================================\")\n",
        "print(\"              FINAL ANSWERS\")\n",
        "print(\"========================================\")\n",
        "\n",
        "print(\"V(S0) =\", values[\"S0\"])\n",
        "print(\"Q(S0, Up) =\", q_value)"
      ]
    }

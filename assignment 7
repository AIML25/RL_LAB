      "source": [
        "n = int(input(\"Enter number of time steps: \"))\n",
        "\n",
        "rewards = []\n",
        "\n",
        "for i in range(n):\n",
        "    r = float(input(f\"Enter reward R{i}: \"))\n",
        "    rewards.append(r)\n",
        "\n",
        "gamma = float(input(\"Enter discount factor: \"))\n",
        "\n",
        "# Undiscounted Return\n",
        "undiscounted = sum(rewards)\n",
        "\n",
        "# Discounted Return\n",
        "discounted = 0\n",
        "\n",
        "for t in range(n):\n",
        "    discounted += (gamma ** t) * rewards[t]\n",
        "\n",
        "print(\"\\nRewards =\", rewards)\n",
        "print(\"Undiscounted Return =\", undiscounted)\n",
        "print(\"Discounted Return =\", discounted)"
      ],
      "metadata": {
        "id": "Qxu-WInB5-Fs"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "states = {\n",
        "    \"S0\": (0, 0),\n",
        "    \"S1\": (0, 1),\n",
        "    \"G\":  (0, 2),\n",
        "    \"X\":  (1, 0),\n",
        "    \"S3\": (1, 1),\n",
        "    \"S4\": (1, 2)\n",
        "}\n",
        "\n",
        "grid = [\n",
        "    [\"S0\", \"S1\", \"G\"],\n",
        "    [\"X\", \"S3\", \"S4\"]\n",
        "]\n",
        "\n",
        "actions = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "gamma = 0.9\n",
        "\n",
        "\n",
        "def transition(state, action):\n",
        "\n",
        "    if state == \"G\":\n",
        "        return \"G\"\n",
        "\n",
        "    row, col = states[state]\n",
        "\n",
        "    if action == \"Up\":\n",
        "        nr, nc = row - 1, col\n",
        "    elif action == \"Down\":\n",
        "        nr, nc = row + 1, col\n",
        "    elif action == \"Left\":\n",
        "        nr, nc = row, col - 1\n",
        "    elif action == \"Right\":\n",
        "        nr, nc = row, col + 1\n",
        "\n",
        "    # Boundary check\n",
        "    if nr < 0 or nr >= 2 or nc < 0 or nc >= 3:\n",
        "        return state\n",
        "\n",
        "    next_state = grid[nr][nc]\n",
        "\n",
        "    # Obstacle check\n",
        "    if next_state == \"X\":\n",
        "        return state\n",
        "\n",
        "    return next_state\n",
        "\n",
        "\n",
        "def reward(state, action):\n",
        "\n",
        "    next_state = transition(state, action)\n",
        "\n",
        "    if next_state == \"G\":\n",
        "        return 10\n",
        "    else:\n",
        "        return -1\n",
        "\n",
        "\n",
        "state = input(\"Enter state: \")\n",
        "action = input(\"Enter action: \")\n",
        "\n",
        "next_state = transition(state, action)\n",
        "\n",
        "print(\"Current State =\", state)\n",
        "print(\"Action =\", action)\n",
        "print(\"Next State =\", next_state)\n",
        "print(\"Reward =\", reward(state, action))\n",
        "print(\"Discount Factor =\", gamma)"
      ],
